# Local runtime settings for this installation.
# Image pins and the public product version live in release.env.

# PostgreSQL settings used by the composed stack.
POSTGRES_DB=bakasub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional host ports for the public services.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Absolute path to the local media library mounted into the backend container.
VIDEO_DIR=/absolute/path/to/your/videos